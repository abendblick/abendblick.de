---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <div class="grid place-items-center frame text-center font-serif px-2 sm: p4">
        <main class="mx-8 sm:mx-20 max-w-screen-md grid grid-cols-2 gap-8 prose overflow-auto">
            <section class="col-span-2 flex flex-col items-center gap-4">
                <header class="px-4 rounded-sm text-xl font-[600] bg-yellow-500/50">Was?</header>
                <p>
                    Wir holen begeisterte MusikerInnen auf die Bühne, die ein buntes Programm für
                    Dich zaubern werden - also lass Dich überraschen!
                </p>
            </section>
            <section class="col-span-1 flex flex-col items-center gap-4">
                <header class="px-4 rounded-sm text-xl font-[600] bg-yellow-500/50">Wann?</header>
                <div>
                    <p class="font-semibold">14.02.2025</p>
                    <p>Einlass: 18:30 Uhr</p>
                    <p class="font-semibold">Beginn: 18:45 Uhr</p>
                    <p class="center font-semibold -rotate-25 text-yellow-500/75 text-xl">&</p>
                    <p class="font-semibold">28.03.2025</p>
                    <p>Einlass: 18:30 Uhr</p>
                    <p class="font-semibold">Beginn: 18:45 Uhr</p>
                </div>
            </section>
            <section class="col-span-1 flex flex-col items-center gap-4">
                <header class="px-4 rounded-sm text-xl font-[600] bg-yellow-500/50">Wo?</header>
                <div>
                    <p>In der gemütlichen</p>
                    <p>Taranta Babu</p>
                    <p>Amalienstraße 33</p>
                    <p>44137 Dortmund</p>
                </div>
            </section>
            <section class="col-span-2 flex flex-col items-center gap-4">
                <header class="px-4 rounded-sm text-xl font-[600] bg-yellow-500/50">
                    Möchtest du auftreten?
                </header>
                <div>
                    <p>
                        Melde Dich gerne per <a href="mailto:abendblick.musik@proton.me">Mail</a> oder
                        <a href="https://instagram.com/abendblick.musik">Instagram</a> bei uns, wenn
                        du alleine oder mit Freunden auftreten möchtest! Jede Musik ist willkommen:)
                        E-Piano, Mikros, Verstärker usw. sind vorhanden. Bei Fragen melde Dich gerne
                        bei uns.
                    </p>
                </div>
            </section>
        </main>
    </div>
</Layout>
